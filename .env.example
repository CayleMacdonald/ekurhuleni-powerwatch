# --- Supabase (leave empty to run in labelled DEMO MODE) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server only. Never expose to the browser.

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CRON_SECRET=                          # long random string; Vercel Cron sends it as Bearer token
REPORTER_HASH_SALT=                   # long random string; used to hash IPs for duplicate/abuse checks
CLUSTER_THRESHOLD=3                   # independent reporters needed to flag a possible widespread outage
CLUSTER_WINDOW_MINUTES=60

# --- Web push (npx web-push generate-vapid-keys) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@example.org

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=PowerWatch <alerts@your-verified-domain.example>

# --- WhatsApp Cloud API (Meta). Requires approved message templates + user opt-in ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=outage_update
WHATSAPP_TEMPLATE_LANG=en

# --- Optional source credentials (each adapter is enabled from the Admin > Sources page) ---
X_BEARER_TOKEN=                       # official X API v2, only for verified municipal accounts
